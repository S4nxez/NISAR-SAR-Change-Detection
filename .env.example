# Copy to .env (git-ignored) and fill in. podman-compose.yml and the pipeline both read this file.

# Legacy stack (podman-compose.yml): MySQL credentials of the Spring backend
MYSQL_ROOT_PASSWORD=
MYSQL_USER=root

# Pipeline: NASA Earthdata Login (https://urs.earthdata.nasa.gov), needed to download NISAR GUNW from ASF.
# Either a token (Profile > Generate Token) or username + password; the token wins if both are set.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Pipeline: OpenET API key (free account at https://openetdata.org), for the 2026 evapotranspiration
OPENET_API_KEY=

# Optional: where the pipeline stores downloaded and derived data (default: <repo>/data)
# IRRIGATION_DATA_DIR=
