[Unit]
Description=Roadmap agent at night usage windows (Mon-Fri)

[Timer]
# One run per night, in the 01:00-06:00 usage window (Pro plan weekly limits)
OnCalendar=Mon..Fri *-*-* 01:00:00
# Don't catch up missed runs (e.g. Pi off): they would land in daytime windows
Persistent=false

[Install]
WantedBy=timers.target
